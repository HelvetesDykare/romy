PORT=3001
FRONTEND_URL=http://localhost:3000

# Postgres (self-hosted — plain Postgres or any Postgres-compatible)
DATABASE_URL=postgres://postgres:password@localhost:5432/romy

# JWT secret — generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret

# Download token signing secret — generate with: openssl rand -hex 32
DOWNLOAD_SIGNING_SECRET=

# Object storage (S3-compatible)
# Recommended: OVHcloud Object Storage or Scaleway Object Storage (French data centers)
# Create a bucket and API key at ovhcloud.com or scaleway.com
# Leave blank to use local filesystem storage (backend/uploads/) — suitable for local dev
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=romy

# AI model keys — cloud fallbacks, not required for sovereign deployment
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Sovereign model endpoint — Mistral AI (French company, EU infrastructure)
# Get an API key at https://console.mistral.ai
#
# Option A — Mistral API (managed, French data center):
#   VLLM_BASE_URL=https://api.mistral.ai/v1
#   VLLM_MAIN_MODEL=mistral-large-latest
#   VLLM_LIGHT_MODEL=mistral-small-latest
#
# Option B — Self-hosted (fully on-prem, zero cloud):
#   VLLM_BASE_URL=http://localhost:8000/v1
#   VLLM_MAIN_MODEL=<model-id>
#
# Select "Local Model" in the chat UI once VLLM_BASE_URL is set.
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_MAIN_MODEL=
VLLM_LIGHT_MODEL=

# MCP servers (JSON array) — connect any MCP server, tools appear in every conversation.
# transport: "http" (default, Streamable HTTP) or "sse" (legacy)
# apiKey: omit for servers that require no authentication
#
# JusticeLibre (https://justicelibre.org) — 4M+ French decisions, free, no auth required:
#   {"name":"justicelibre","url":"https://justicelibre.org/mcp"}
MCP_SERVERS=[{"name":"justicelibre","url":"https://justicelibre.org/mcp"}]

# PISTE — register free at https://piste.api.gouv.fr
# Required for Légifrance + Judilibre native tools
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=
